{
  "name": "db-visualizer",
  "displayName": "DB Visualizer",
  "description": "Visualizes your database schema directly inside VS Code",
  "version": "1.0.0",
  "publisher": "SmartOne",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shashank-ganai/db_visual.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "scripts": {
    "package": "vsce package --no-git-tag-version --no-dependencies"
  },
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dbvisualizer.start",
        "title": "DB Visualizer: Open Full Screen",
        "icon": "$(database)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbvisualizer-sidebar",
          "title": "DB Visualizer",
          "icon": "$(database)"
        }
      ]
    },
    "views": {
      "dbvisualizer-sidebar": [
        {
          "id": "dbvisualizer.sidebarView",
          "name": "Controls",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "DB Visualizer",
      "properties": {
        "dbvisualizer.url": {
          "type": "string",
          "default": "https://dbvisual.fabai.cloud",
          "description": "URL of the DB Visualizer server"
        }
      }
    }
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.9.2"
  }
}
